# Copy this file to .env and fill in your local values.
# .env is in .gitignore — never commit it.

ConnectionStrings__Default=Server=localhost;Database=SyriaShopDb;Trusted_Connection=True;TrustServerCertificate=True;

# JWT — SigningKey must be at least 32 characters (256 bits for HMAC-SHA256).
Auth__Issuer=SyriaShop
Auth__Audience=SyriaShopApi
Auth__SigningKey=REPLACE_ME_WITH_A_RANDOM_64_CHAR_HEX_KEY

# Optional seed accounts created on startup (used for local testing).
Auth__SeedAdminEmail=
Auth__SeedAdminPassword=
Auth__SeedCustomerEmail=
Auth__SeedCustomerPassword=
